# Copy this file to .env and replace values with your Neon PostgreSQL credentials.
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>?schema=public"

# Meta WhatsApp Cloud API integration
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_EMBEDDED_SIGNUP_REDIRECT_URI=""
META_GRAPH_API_VERSION="v23.0"

# Internal scheduler auth token for the reminder worker
REMINDER_API_TOKEN="replace-with-strong-secret"

# Optional default doctor display name used in WhatsApp reminder messages
DOCTOR_DISPLAY_NAME="Dr. Ahmed"

# Optional fallback doctor WhatsApp number when clinic metadata does not provide one
DOCTOR_WHATSAPP_PHONE="+9647XXXXXXXXX"

# Optional server-side development/test fallback for Meta WhatsApp Cloud credentials.
# These values are only used on the server and are never exposed to the browser.
WHATSAPP_ACCESS_TOKEN="replace-with-meta-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="1198540086683069"
WHATSAPP_BUSINESS_ACCOUNT_ID="2095133288044935"
WHATSAPP_APPOINTMENT_TEMPLATE_NAME="appointment_reminder"
# Use the exact language code configured for your approved template in Meta (for example: ar or ar_AR).
WHATSAPP_APPOINTMENT_TEMPLATE_LANGUAGE_CODE=""
# Vonage sends the plain-text reminder first. If Vonage reports that the
# customer-care window is closed, it sends this approved template instead.
VONAGE_WHATSAPP_TEMPLATE_NAME="appointment_reminder"
VONAGE_WHATSAPP_TEMPLATE_LOCALE="en"
VONAGE_WHATSAPP_TEMPLATE_PARAMETER_ORDER="patientName,appointmentDate,appointmentTime,clinicName"
# Keep plain-text and template endpoints explicit so production templates do
# not accidentally use the Sandbox endpoint.
VONAGE_TEMPLATE_MESSAGES_API_URL="https://api.nexmo.com/v1/messages"

# Encrypt doctor WhatsApp provider tokens at rest
WHATSAPP_TOKEN_ENCRYPTION_KEY="replace-with-long-random-secret"
