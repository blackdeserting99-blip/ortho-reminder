# Copy this file to .env and replace values with your Neon PostgreSQL credentials.
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>?schema=public"

# Meta WhatsApp Embedded Signup
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
CALLBACK_URL="https://your-domain.com/settings/whatsapp"

# Encrypt doctor WhatsApp access tokens at rest
WHATSAPP_TOKEN_ENCRYPTION_KEY="replace-with-long-random-secret"

# Optional Graph API version override
WHATSAPP_API_VERSION="v21.0"
