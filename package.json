{
  "name": "ortho-reminder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/next-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "prisma generate && prisma migrate deploy && node scripts/cf-build.mjs",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.20",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/hashes": "^1.8.0",
    "@prisma/adapter-neon": "6.16.3",
    "@prisma/client": "6.16.3",
    "bcryptjs": "^3.0.3",
    "empathic": "^2.0.0",
    "fast-check": "^3.23.2",
    "lucide-react": "^1.21.0",
    "next": "15.5.21",
    "next-auth": "^4.24.14",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "prisma": "6.16.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "@aws-sdk/credential-provider-ini": "3.973.13"
  },
  "trustedDependencies": [
    "unrs-resolver",
    "prisma",
    "@prisma/client",
    "@prisma/engines",
    "esbuild",
    "workerd",
    "sharp"
  ]
